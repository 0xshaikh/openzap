# ---------------------------------------------------------------------------
# OpenZap configuration
#
# Copy this file to `.env`, adjust the values, then load it into your shell:
#   set -a && . ./.env && set +a
# ---------------------------------------------------------------------------

# --- Data directory -------------------------------------------------------
# Where workflow JSON files, the SQLite database and logs live.
OPENZAP_HOME=~/.openzap

# --- Server / webhooks ----------------------------------------------------
# Bind address and port for `openzap serve` (also used by the Makefile target).
OPENZAP_HOST=127.0.0.1
OPENZAP_PORT=8080

# Public URL advertised for webhook endpoints. Set this to the address your
# caller can reach, e.g. https://zap.example.com  (omit the trailing slash).
OPENZAP_BASE_URL=

# Maximum accepted webhook request body, in bytes (default 1 MiB).
OPENZAP_MAX_BODY_BYTES=1048576

# Override the SQLite database path (default: $OPENZAP_HOME/openzap.db).
# OPENZAP_DB=/var/lib/openzap/openzap.db

# --- SMTP (used by the `email` action) ------------------------------------
# Leave SMTP_HOST empty to disable the email action: steps that use it are
# recorded as `skipped` instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=openzap@localhost
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=30
